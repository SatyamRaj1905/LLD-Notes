digraph FoodDeliveryUML {
  graph [
    bgcolor="#070A12",
    rankdir=TB,
    splines=ortho,
    nodesep=0.28,
    ranksep=0.58,
    pad=0.18,
    margin=0,
    compound=true,
    newrank=true,
    pack=true,
    packmode="cluster",
    outputorder=edgesfirst,
    fontname="Helvetica"
  ];

  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [color="#526070", penwidth=1.15, arrowsize=0.65, fontname="Helvetica", fontsize=8];

  Title [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
      <TR><TD><FONT COLOR="#F8FAFC" POINT-SIZE="24"><B>Food Delivery Application</B></FONT></TD></TR>
      <TR><TD><FONT COLOR="#8291A7" POINT-SIZE="11">COMPACT UML CLASS DIAGRAM  ·  TYPESCRIPT</FONT></TD></TR>
    </TABLE>
  >];

  subgraph cluster_application {
    label="  APPLICATION CORE  ";
    labelloc=t;
    fontname="Helvetica Bold";
    fontsize=11;
    fontcolor="#60A5FA";
    color="#1E3A5F";
    fillcolor="#0A1220";
    style="rounded,filled";
    penwidth=1.2;
    margin=14;

    SwiggyService [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#26364D" BGCOLOR="#101827">
        <TR><TD BGCOLOR="#173B63"><FONT COLOR="#EFF6FF" POINT-SIZE="13"><B>SwiggyService</B></FONT><BR/><FONT COLOR="#93C5FD" POINT-SIZE="9">&lt;&lt;Singleton&gt;&gt;</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#94A3B8">+ <U>instance: SwiggyService</U><BR/>- customers: Map&lt;string, Customer&gt;<BR/>- deliveryAgents: Map&lt;string, DeliveryAgent&gt;<BR/>- restros: Map&lt;string, Restro&gt;<BR/>- orders: Map&lt;string, Order&gt;</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#DCE7F5">- SwiggyService()<BR/>+ <U>getInstance(): SwiggyService</U><BR/>+ createCustomers(name, phone): Customer<BR/>+ createDeliveryAgents(name, phone): DeliveryAgent<BR/>+ createRestro(name, address): Restro<BR/>+ makeOrder(..., payment, discount?): Order<BR/>+ cancelOrder(orderId): void<BR/>+ assignOrderToDeliveryAgent(...): void<BR/>+ updateStatus(orderId, status): void</FONT></TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_people {
    label="  ACTORS & RESTAURANT  ";
    labelloc=t;
    fontname="Helvetica Bold";
    fontsize=11;
    fontcolor="#C4B5FD";
    color="#3B2D64";
    fillcolor="#0F0D1B";
    style="rounded,filled";
    penwidth=1.2;
    margin=14;

    User [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#3D355A" BGCOLOR="#151225">
        <TR><TD BGCOLOR="#4C3583"><FONT COLOR="white"><B>User</B></FONT><BR/><FONT COLOR="#DDD6FE" POINT-SIZE="9">&lt;&lt;abstract · OrderObserver&gt;&gt;</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#A99FC3">- userId: string<BR/>- name: string<BR/>- phone: string<BR/>- email: string | null</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#E9E5F5">+ getId(), getName(), getPhone(), getEmail()<BR/><I>+ onOrderStatusChange(order): void</I></FONT></TD></TR>
      </TABLE>
    >];

    Customer [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#3D355A" BGCOLOR="#151225">
        <TR><TD BGCOLOR="#2D2350"><FONT COLOR="#F5F3FF"><B>Customer</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#A99FC3">- allAddresses: Address[]<BR/>- currentAddress: Address | null<BR/>- orderHistory: Order[]<BR/>- cart: CartItem[]</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#E9E5F5">+ addAddress(address): void<BR/>+ setCurrentAddress(address): void<BR/>+ addToCart(item): void<BR/>+ addorderHistory(order): void<BR/>+ onOrderStatusChange(order): void</FONT></TD></TR>
      </TABLE>
    >];

    DeliveryAgent [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#3D355A" BGCOLOR="#151225">
        <TR><TD BGCOLOR="#2D2350"><FONT COLOR="#F5F3FF"><B>DeliveryAgent</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#A99FC3">- isAvailable: boolean<BR/>- deliveryHistory: Order[]<BR/>- currentLocation: Address | null</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#E9E5F5">+ makeOnline(), makeOffline()<BR/>+ isAgentAvailable(): boolean<BR/>+ addOrderToHistory(order): void<BR/>+ setCurrentAddress(address): void<BR/>+ changeOrderStatus(...): void<BR/>+ onOrderStatusChange(order): void</FONT></TD></TR>
      </TABLE>
    >];

    RestroAdmin [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#3D355A" BGCOLOR="#151225">
        <TR><TD BGCOLOR="#2D2350"><FONT COLOR="#F5F3FF"><B>RestroAdmin</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#A99FC3">+ restaurantId: string</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#E9E5F5">+ onOrderStatusChange(order): void</FONT></TD></TR>
      </TABLE>
    >];

    Restro [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#3D355A" BGCOLOR="#151225">
        <TR><TD BGCOLOR="#4C3583"><FONT COLOR="white"><B>Restro</B></FONT><BR/><FONT COLOR="#DDD6FE" POINT-SIZE="9">&lt;&lt;OrderObserver&gt;&gt;</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#A99FC3">- id: string<BR/>- name: string<BR/>- adresss: Address<BR/>- menu: Menu | null<BR/>- isAvaialble: boolean<BR/>- orderHistory: Order[]</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#E9E5F5">+ setMenu(menu), getMenu()<BR/>+ toggleAvailability(): void<BR/>+ addOrderToHistory(order): void<BR/>+ changeOrderStatus(...): void<BR/>+ onOrderStatusChange(order): void</FONT></TD></TR>
      </TABLE>
    >];

    { rank=same; Customer; DeliveryAgent; }
    { rank=same; RestroAdmin; Restro; }
    Customer -> RestroAdmin [style=invis, weight=20];
    DeliveryAgent -> Restro [style=invis, weight=20];
  }

  subgraph cluster_order {
    label="  ORDER DOMAIN  ";
    labelloc=t;
    fontname="Helvetica Bold";
    fontsize=11;
    fontcolor="#67E8F9";
    color="#164E63";
    fillcolor="#07151B";
    style="rounded,filled";
    penwidth=1.2;
    margin=14;

    Order [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F5261" BGCOLOR="#0D1C24">
        <TR><TD BGCOLOR="#0E6374"><FONT COLOR="white" POINT-SIZE="13"><B>Order</B></FONT><BR/><FONT COLOR="#A5F3FC" POINT-SIZE="9">&lt;&lt;Observer Subject&gt;&gt;</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#8FB5C0">- id: string<BR/>- customer: Customer<BR/>- restaurant: Restro<BR/>- grossAmount / netAmount: number<BR/>- items: CartItem[]<BR/>- paymentStrategy: IPayment<BR/>- discountStrategy: IDiscount | null<BR/>- deliveryAgent: DeliveryAgent | null<BR/>- orderStatus: OrderStatus<BR/>- observers: OrderObserver[]</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#D9F7FA">+ changeOrderStatus(status): void<BR/>+ getNetAmountAfterDiscount(): number<BR/>+ getPaymentStrategy(): IPayment<BR/>+ assignDeliverAgent(agent): void<BR/>+ addObservers(observer): void<BR/>+ notifyObservers(): void</FONT></TD></TR>
      </TABLE>
    >];

    CartItem [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F5261" BGCOLOR="#0D1C24">
        <TR><TD BGCOLOR="#123C48"><FONT COLOR="#ECFEFF"><B>CartItem</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#8FB5C0">- item: MenuItem<BR/>- quantity: number<BR/>- instructions: string | null</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#D9F7FA">+ getItem(): MenuItem<BR/>+ getQuantity(): number<BR/>+ getInstructions(): string</FONT></TD></TR>
      </TABLE>
    >];

    OrderObserver [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F5261" BGCOLOR="#0D1C24">
        <TR><TD BGCOLOR="#123C48"><FONT COLOR="#A5F3FC" POINT-SIZE="9">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT COLOR="#ECFEFF"><B>OrderObserver</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#D9F7FA">+ onOrderStatusChange(order): void</FONT></TD></TR>
      </TABLE>
    >];

    { rank=same; CartItem; OrderObserver; }
  }

  subgraph cluster_catalog {
    label="  CATALOG & LOCATION  ";
    labelloc=t;
    fontname="Helvetica Bold";
    fontsize=11;
    fontcolor="#86EFAC";
    color="#195A38";
    fillcolor="#08170F";
    style="rounded,filled";
    penwidth=1.2;
    margin=14;

    Address [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#28593B" BGCOLOR="#0D1C13">
        <TR><TD BGCOLOR="#174C2D"><FONT COLOR="#F0FDF4"><B>Address</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#8FB29B">- street: string<BR/>- city: string<BR/>- lat / long: string | null</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#DCFCE7">+ getAddress(): string</FONT></TD></TR>
      </TABLE>
    >];

    Menu [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#28593B" BGCOLOR="#0D1C13">
        <TR><TD BGCOLOR="#174C2D"><FONT COLOR="#F0FDF4"><B>Menu</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#8FB29B">- items: Map&lt;string, MenuItem&gt;</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#DCFCE7">+ addMenuItem(item): void<BR/>+ remmoveItem(itemId): void<BR/>+ getMenuItem(itemId): MenuItem<BR/>+ getAllMenuItems(): MenuItem[]</FONT></TD></TR>
      </TABLE>
    >];

    MenuItem [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#28593B" BGCOLOR="#0D1C13">
        <TR><TD BGCOLOR="#174C2D"><FONT COLOR="#F0FDF4"><B>MenuItem</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#8FB29B">- id: string<BR/>- name: string<BR/>- price: number<BR/>- available: boolean<BR/>- description / category: string | null</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#DCFCE7">+ getId(), getName(), getPrice()<BR/>+ getDescription(), getCategory()<BR/>+ isAvailable(): boolean<BR/>+ toggleAvailability(): void</FONT></TD></TR>
      </TABLE>
    >];

    { rank=same; Address; Menu; }
  }

  subgraph cluster_strategies {
    label="  PLUGGABLE STRATEGIES  ";
    labelloc=t;
    fontname="Helvetica Bold";
    fontsize=11;
    fontcolor="#FCD34D";
    color="#664A16";
    fillcolor="#181207";
    style="rounded,filled";
    penwidth=1.2;
    margin=14;

    IPayment [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#665321" BGCOLOR="#211A0B">
        <TR><TD BGCOLOR="#684B0B"><FONT COLOR="#FEF3C7" POINT-SIZE="9">&lt;&lt;interface · Strategy&gt;&gt;</FONT><BR/><FONT COLOR="white"><B>IPayment</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#FEF3C7">+ pay(amount): PaymentStatus<BR/>+ refund(amount): PaymentStatus</FONT></TD></TR>
      </TABLE>
    >];

    CreditCard [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#665321" BGCOLOR="#211A0B">
        <TR><TD BGCOLOR="#3C310F"><FONT COLOR="#FFF7D6"><B>CreditCard</B></FONT></TD></TR>
        <TR><TD><FONT COLOR="#E7D9A5">+ pay()  ·  + refund()</FONT></TD></TR>
      </TABLE>
    >];

    DebitCard [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#665321" BGCOLOR="#211A0B">
        <TR><TD BGCOLOR="#3C310F"><FONT COLOR="#FFF7D6"><B>DebitCard</B></FONT></TD></TR>
        <TR><TD><FONT COLOR="#E7D9A5">+ pay()  ·  + refund()</FONT></TD></TR>
      </TABLE>
    >];

    UPI [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#665321" BGCOLOR="#211A0B">
        <TR><TD BGCOLOR="#3C310F"><FONT COLOR="#FFF7D6"><B>UPI</B></FONT></TD></TR>
        <TR><TD><FONT COLOR="#E7D9A5">+ pay()  ·  + refund()</FONT></TD></TR>
      </TABLE>
    >];

    IDiscount [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#665321" BGCOLOR="#211A0B">
        <TR><TD BGCOLOR="#684B0B"><FONT COLOR="#FEF3C7" POINT-SIZE="9">&lt;&lt;interface · Strategy&gt;&gt;</FONT><BR/><FONT COLOR="white"><B>IDiscount</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#FEF3C7">+ applyDiscount(baseAmount): number</FONT></TD></TR>
      </TABLE>
    >];

    FlatDiscount [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#665321" BGCOLOR="#211A0B">
        <TR><TD BGCOLOR="#3C310F"><FONT COLOR="#FFF7D6"><B>FlatDiscount</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#E7D9A5">- flatAmount: number<BR/>+ applyDiscount(): number</FONT></TD></TR>
      </TABLE>
    >];

    PercentageDiscount [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#665321" BGCOLOR="#211A0B">
        <TR><TD BGCOLOR="#3C310F"><FONT COLOR="#FFF7D6"><B>PercentageDiscount</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#E7D9A5">- percentageDiscount: number<BR/>+ applyDiscount(): number</FONT></TD></TR>
      </TABLE>
    >];

    { rank=same; IPayment; IDiscount; }
    { rank=same; CreditCard; DebitCard; UPI; FlatDiscount; PercentageDiscount; }
  }

  subgraph cluster_enums {
    label="  STATES  ";
    labelloc=t;
    fontname="Helvetica Bold";
    fontsize=11;
    fontcolor="#FDA4AF";
    color="#652A38";
    fillcolor="#190C10";
    style="rounded,filled";
    penwidth=1.2;
    margin=14;

    OrderStatus [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#673140" BGCOLOR="#211016">
        <TR><TD BGCOLOR="#70263C"><FONT COLOR="#FFE4E6" POINT-SIZE="9">&lt;&lt;enum&gt;&gt;</FONT><BR/><FONT COLOR="white"><B>OrderStatus</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#FBC8CF">PENDING · CONFIRMED · PREPARED<BR/>READY_FOR_DELIVERY<BR/>OUT_FOR_DELIVERY · DELIVERED<BR/>CANCELLED</FONT></TD></TR>
      </TABLE>
    >];

    PaymentStatus [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#673140" BGCOLOR="#211016">
        <TR><TD BGCOLOR="#70263C"><FONT COLOR="#FFE4E6" POINT-SIZE="9">&lt;&lt;enum&gt;&gt;</FONT><BR/><FONT COLOR="white"><B>PaymentStatus</B></FONT></TD></TR>
        <TR><TD><FONT COLOR="#FBC8CF">PENDING · COMPLETED · FAILED</FONT></TD></TR>
      </TABLE>
    >];
  }

  Legend [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="8" CELLPADDING="3" BGCOLOR="#0D1320">
      <TR>
        <TD><FONT COLOR="#A78BFA"><B>△</B> inheritance / implementation</FONT></TD>
        <TD><FONT COLOR="#38BDF8"><B>→</B> association</FONT></TD>
        <TD><FONT COLOR="#34D399"><B>◇</B> aggregation</FONT></TD>
        <TD><FONT COLOR="#FBBF24"><B>→</B> strategy</FONT></TD>
        <TD><FONT COLOR="#F472B6"><B>→</B> observer</FONT></TD>
      </TR>
      <TR><TD COLSPAN="5"><FONT COLOR="#66758B" POINT-SIZE="9">Only structural and pattern-critical relationships are drawn; member types retain the remaining dependencies.</FONT></TD></TR>
    </TABLE>
  >];

  // Clean top-to-bottom composition.
  Title -> SwiggyService [style=invis, weight=100];
  SwiggyService -> Order [color="#60A5FA", penwidth=1.6, arrowhead=vee];

  // User hierarchy: layout flows parent → child while the UML arrow points to parent.
  User -> Customer [dir=back, arrowtail=empty, color="#A78BFA", penwidth=1.35];
  User -> DeliveryAgent [dir=back, arrowtail=empty, color="#A78BFA", penwidth=1.35];
  User -> RestroAdmin [dir=back, arrowtail=empty, color="#A78BFA", penwidth=1.35];

  // Observer Pattern.
  Order -> OrderObserver [dir=both, arrowtail=odiamond, arrowhead=none, color="#F472B6", penwidth=1.5];
  OrderObserver -> User [dir=back, arrowtail=empty, style=dashed, color="#F472B6", penwidth=1.35];
  OrderObserver -> Restro [dir=back, arrowtail=empty, style=dashed, color="#F472B6", penwidth=1.35];

  // Core composition. Cross-panel associations already visible as typed members are omitted.
  Order -> CartItem [dir=both, arrowtail=odiamond, arrowhead=none, color="#34D399", penwidth=1.35];
  Menu -> MenuItem [dir=both, arrowtail=diamond, arrowhead=none, color="#34D399"];

  // Strategy Pattern.
  Order -> IPayment [color="#FBBF24", penwidth=1.5, arrowhead=vee, weight=3];
  Order -> IDiscount [color="#FBBF24", penwidth=1.5, arrowhead=vee];
  IPayment -> CreditCard [dir=back, arrowtail=empty, style=dashed, color="#FBBF24"];
  IPayment -> DebitCard [dir=back, arrowtail=empty, style=dashed, color="#FBBF24"];
  IPayment -> UPI [dir=back, arrowtail=empty, style=dashed, color="#FBBF24"];
  IDiscount -> FlatDiscount [dir=back, arrowtail=empty, style=dashed, color="#FBBF24"];
  IDiscount -> PercentageDiscount [dir=back, arrowtail=empty, style=dashed, color="#FBBF24"];

  // Compact placement hints. Invisible edges never appear in the output.
  User -> SwiggyService [style=invis, weight=100];
  SwiggyService -> Menu [style=invis, weight=100];
  MenuItem -> OrderStatus [style=invis, weight=80];
  OrderStatus -> Legend [style=invis, weight=20];
  PaymentStatus -> Legend [style=invis, weight=20];

  { rank=same; User; SwiggyService; Menu; }
}
